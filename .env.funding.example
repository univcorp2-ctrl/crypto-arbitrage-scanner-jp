# Funding-rate platform. Copy to .env.funding and keep that file outside Git.
FUNDING_HOST=127.0.0.1
FUNDING_PORT=8100
FUNDING_DATA_DIR=data
FUNDING_SETTINGS_PATH=data/funding_settings.json
FUNDING_VAULT_PATH=data/funding_vault.db
FUNDING_SCAN_INTERVAL_SECONDS=15
FUNDING_AUTOSTART=false
FUNDING_MODE=paper

# Generate locally with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FUNDING_VAULT_KEY=GENERATE_LOCALLY_DO_NOT_COMMIT

# Required for non-loopback write operations. Use a long random value and never commit it.
FUNDING_ADMIN_TOKEN=SET_A_LOCAL_RANDOM_VALUE

# Two independent live locks. Both are false by default.
FUNDING_EXECUTION_MODE=paper
FUNDING_LIVE_ENABLED=false
FUNDING_MAX_ORDER_BTC=0.05
FUNDING_MAX_DAILY_NOTIONAL_JPY=100000

# Optional fallback when the encrypted local vault is not used.
# Create a bitFlyer key without withdrawal, coin-send, or transfer permissions.
BITFLYER_API_KEY=YOUR_SECRET_HERE
BITFLYER_API_SECRET=YOUR_SECRET_HERE
