# Web / paper-trading runtime
ARB_MODE=public-live-paper
ARB_DB_PATH=data/arbscanner.db
ARB_CONFIG_PATH=config.yml
ARB_SIM_INTERVAL_SECONDS=30
ARB_AUTOSTART=true
ARB_HOST=127.0.0.1
ARB_PORT=8000

# Private API credentials are optional in paper mode.
# Store real values only in the server environment or a secret manager.
# Never commit this file after adding values. Never enable withdrawal permission.
# BITBANK_API_KEY=
# BITBANK_API_SECRET=
# GMOCOIN_API_KEY=
# GMOCOIN_API_SECRET=
# BITFLYER_API_KEY=
# BITFLYER_API_SECRET=
# COINCHECK_ACCESS_KEY=
# COINCHECK_SECRET_KEY=
# BITTRADE_ACCESS_KEY=
# BITTRADE_SECRET_KEY=
# ZAIF_API_KEY=
# ZAIF_API_SECRET=
# BINANCE_JP_API_KEY=
# BINANCE_JP_API_SECRET=
