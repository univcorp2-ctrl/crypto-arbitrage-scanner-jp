# Multi-venue console
FUNDING_MULTI_HOST=127.0.0.1
FUNDING_MULTI_PORT=8011
FUNDING_MULTI_SETTINGS_PATH=data/funding_multi_settings.json
FUNDING_VAULT_PATH=data/funding_vault.db
# Generate a Fernet key locally and inject it as a secret. Never commit the value.
FUNDING_VAULT_KEY=GENERATE_LOCALLY_DO_NOT_COMMIT
FUNDING_ADMIN_TOKEN=

# Fail-closed live controls. Keep false until paper/observe validation is complete.
FUNDING_MULTI_LIVE_ENABLED=false
FUNDING_MULTI_MAX_LIVE_NOTIONAL_USDT=0

# Enable and attest each venue independently. Attestation must be refreshed within 30 days.
FUNDING_MEXC_LIVE_ENABLED=false
FUNDING_MEXC_JP_ELIGIBILITY_ATTESTED=
FUNDING_GATE_LIVE_ENABLED=false
FUNDING_GATE_JP_ELIGIBILITY_ATTESTED=
FUNDING_BITRUE_LIVE_ENABLED=false
FUNDING_BITRUE_JP_ELIGIBILITY_ATTESTED=
FUNDING_BITGET_LIVE_ENABLED=false
FUNDING_BITGET_JP_ELIGIBILITY_ATTESTED=

# OKX/BingX private routing is blocked by code in this release because current
# published restrictions include Japan for relevant services. Public research remains available.
